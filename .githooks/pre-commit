#!/usr/bin/env bash
#
# pre-commit — block PII and credentials from reaching a PUBLIC repository.
#
# This repo is served at kvalnir.github.io/ast/ and its source is world
# readable, so the cost of one bad commit is permanent: rewriting history does
# not un-publish anything that was fetched, forked, or cached in the meantime.
# .gitignore only guards *untracked* files; this guards the thing .gitignore
# cannot see, which is content pasted into files that are already tracked.
#
# What it scans: the ADDED lines of the staged diff, not the whole file. You
# are never punished for pre-existing content you did not touch.
#
# Install (once per clone -- core.hooksPath is local config, it does not clone):
#   git config core.hooksPath .githooks
#
# Escape hatches, in order of preference:
#   1. Append  pii-ok  as a comment on the offending line (survives, self
#      documents, and shows up in review).
#   2. PII_HOOK_SKIP=1 git commit ...   -- skip for one commit.
#   3. git commit --no-verify           -- skips every hook, blunter.
#
# Deliberately NOT hardcoded: your email, your username, your hostnames. A
# scanner that embeds the strings it hunts for would publish them itself the
# moment it is committed. Personal identifiers are read at runtime from
# `git config user.email` and $USER instead, and extra terms can go in
# .githooks/personal-terms.local -- matched by *.local in .gitignore, so it
# stays on your disk.

set -uo pipefail

[ "${PII_HOOK_SKIP:-0}" = "1" ] && exit 0

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  against=HEAD
else
  against=$(git hash-object -t tree /dev/null)   # initial commit
fi

red=""; yellow=""; bold=""; reset=""
if [ -t 2 ]; then
  red=$(printf '\033[31m'); yellow=$(printf '\033[33m')
  bold=$(printf '\033[1m'); reset=$(printf '\033[0m')
fi

findings=$(mktemp) || exit 1
trap 'rm -f "$findings"' EXIT

# ---------------------------------------------------------------------------
# 1. Sensitive FILENAMES being added.
#
# .gitignore already covers these, so reaching here means someone used
# `git add -f`, which is exactly the moment worth interrupting.
# ---------------------------------------------------------------------------
git diff --cached --name-only --diff-filter=ACM -z "$against" |
while IFS= read -r -d '' path; do
  case "$path" in
    .githooks/*) continue ;;
  esac
  if printf '%s\n' "$path" | grep -qE \
    '(^|/)\.env($|\.)|(^|/)id_(rsa|dsa|ecdsa|ed25519)($|\.)|\.(pem|key|p12|pfx|keystore)$|(^|/)\.netrc$|(^|/)\.htpasswd$|(^|/)credentials\.json$|(^|/)secrets?\.(json|ya?ml)$|\.(sqlite3?|db|har|dump)$'
  then
    printf '%s\t-\tsensitive filename\t%s\n' "$path" "$path" >>"$findings"
  fi
done

# ---------------------------------------------------------------------------
# 2. Sensitive CONTENT in added lines.
#
# .githooks/ is skipped on purpose: this file necessarily contains
# credential-shaped regexes and would flag itself forever.
# ---------------------------------------------------------------------------

# Runtime-derived personal terms. Never written to disk by this script.
personal_re=""
add_term() {
  local t="$1"
  [ -z "$t" ] && return
  # Terms shorter than 4 characters are dropped. A short login name is a
  # substring of ordinary words -- the account here is "hl", which occurs
  # inside "highlight" and "html" and flagged 38 lines of legitimate site
  # content on the first run. Nothing is lost: a short name only matters
  # inside a path, and the home-directory rule already covers that.
  [ "${#t}" -lt 4 ] && return
  t=$(printf '%s' "$t" | sed 's/[][\.*^$(){}?+|/]/\\&/g')   # literal-ise
  if [ -z "$personal_re" ]; then personal_re="$t"; else personal_re="$personal_re|$t"; fi
}
add_term "$(git config user.email 2>/dev/null || true)"
add_term "${USER:-}"
# Extra terms, one plain string per line; blank lines and # comments ignored.
if [ -f .githooks/personal-terms.local ]; then
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    add_term "$line"
  done < .githooks/personal-terms.local
fi

git diff --cached --unified=0 --diff-filter=ACM "$against" |
awk -v personal="$personal_re" '
  BEGIN {
    EMAIL   = "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z][A-Za-z]+"
    # Placeholders and forge addresses that are not anybody personal data.
    EMAILOK = "^(git|noreply|no-reply|user|you|your-email|name|email|someone|test)@|@(github\\.com|example\\.(com|org|net)|localhost|domain\\.com|email\\.com)$"

    n=0
    add("private key block",  "BEGIN [A-Z ]*PRIVATE KEY")
    add("GitHub token",       "gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}")
    add("AWS access key id",  "AKIA[0-9A-Z]{16}")
    add("Slack token",        "xox[abposr]-[A-Za-z0-9-]{10,}")
    add("Google API key",     "AIza[0-9A-Za-z_-]{35}")
    add("generic sk- key",    "sk-[A-Za-z0-9_-]{20,}")
    add("JWT",                "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.")
    add("private IPv4",       "(^|[^0-9.])(192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}|10\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3})([^0-9]|$)")
    add("home directory path","/home/[a-z_][a-z0-9_-]*|/Users/[A-Za-z][A-Za-z0-9_-]*|[Cc]:\\\\Users\\\\[A-Za-z]")

    m=0
    addci("hardcoded credential", "(api[_-]?key|secret|passwd|password|token|auth[_-]?(token|key)|bearer)[\"'"'"' ]*[:=][\"'"'"' ]*[A-Za-z0-9/+=_.-]{12,}")
  }
  function add(nm, re)   { n++; CSN[n]=nm; CSR[n]=re }
  function addci(nm, re) { m++; CIN[m]=nm; CIR[m]=re }
  # A bare match is not reviewable -- "hl" on its own says nothing about why
  # the line tripped. Show a window around it instead, clipped so a long
  # secret is not echoed wholesale into terminal scrollback.
  function ctx(s, len,   from, out, tail) {
    from = s - 30; if (from < 1) from = 1
    tail = from + len + 60
    out = substr(line, from, len + 60)
    sub(/^[ \t]+/, "", out)
    if (from > 1)            out = "..." out
    if (tail <= length(line)) out = out "..."
    return out
  }
  function report(nm, snip) {
    if (length(snip) > 120) snip = substr(snip, 1, 120) "..."
    printf "%s\t%d\t%s\t%s\n", file, lineno, nm, snip
  }

  /^\+\+\+ b\// { file = substr($0, 7); skip = (file ~ /^\.githooks\//); next }
  /^@@/ {
    # @@ -a,b +c,d @@  -> c is the first new-file line number in this hunk
    split($0, p, "+"); split(p[2], q, /[ ,]/); lineno = q[1] + 0; next
  }
  /^\+/ {
    if (skip) { lineno++; next }
    line = substr($0, 2)
    if (line ~ /pii-ok/) { lineno++; next }
    low = tolower(line)

    if (match(line, EMAIL)) {
      e = substr(line, RSTART, RLENGTH)
      if (tolower(e) !~ EMAILOK) report("email address", ctx(RSTART, RLENGTH))
    }
    for (i = 1; i <= n; i++) if (match(line, CSR[i])) report(CSN[i], ctx(RSTART, RLENGTH))
    for (i = 1; i <= m; i++) if (match(low, CIR[i])) report(CIN[i], ctx(RSTART, RLENGTH))
    # Anchored on non-word boundaries so a term only matches as a whole word,
    # not as a fragment buried inside an ordinary identifier.
    if (personal != "" && match(low, "(^|[^a-z0-9_-])(" tolower(personal) ")([^a-z0-9_-]|$)"))
      report("personal identifier", ctx(RSTART, RLENGTH))

    lineno++
    next
  }
' >>"$findings"

# ---------------------------------------------------------------------------
# 3. Verdict
# ---------------------------------------------------------------------------
[ -s "$findings" ] || exit 0

{
  printf '%s%sCommit blocked: possible PII or credentials in staged changes.%s\n\n' "$bold" "$red" "$reset"
  while IFS=$'\t' read -r path line rule snippet; do
    if [ "$line" = "-" ]; then
      printf '  %s%s%s\n      %s\n' "$yellow" "$rule" "$reset" "$path"
    else
      printf '  %s%s:%s%s  %s%s%s\n      %s\n' "$bold" "$path" "$line" "$reset" "$yellow" "$rule" "$reset" "$snippet"
    fi
  done <"$findings"
  printf '\nThis repository is public. Once pushed, a leak is permanent --\n'
  printf 'history rewrites do not recall what was already fetched or cached.\n\n'
  printf 'If a finding is a false positive, append  pii-ok  to that line,\n'
  printf 'or bypass once with  PII_HOOK_SKIP=1 git commit ...\n'
} >&2

exit 1
